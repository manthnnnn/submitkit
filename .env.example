# ─────────────────────────────────────────────────────────────
#  SubmitKit — Environment Variables Reference
#  Copy this file to .env.local and fill in your values.
#  Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key    # NEVER expose this in the browser

# ── Razorpay ──────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret        # Set in Razorpay → Webhooks

# ── Cloudflare R2 (file storage) ──────────────────────────────
# Found in: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# R2_ACCOUNT_ID is your Cloudflare account ID (not the bucket account)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=submitkit-projects                  # Your R2 bucket name

# ── App ───────────────────────────────────────────────────────
# Used for absolute URL generation (sitemaps, OG, etc.)
NEXT_PUBLIC_BASE_URL=https://submitkit.in          # No trailing slash

# ── Admin Panel ───────────────────────────────────────────────
# The password used to log in to /admin — change this before deploying!
ADMIN_SECRET_KEY=change-me-before-production
