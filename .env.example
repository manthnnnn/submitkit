# ─────────────────────────────────────────────────────────────────────
#  SubmitKit — Environment Variables Reference
#  Copy this file to .env.local and fill in your values.
#  Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Razorpay ──────────────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Cloudflare R2 ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=projecthub

# ── Brevo (Transactional Email) ───────────────────────────────────────
# Free plan: 300 emails/day, no credit card needed
# 1. Sign up at https://app.brevo.com
# 2. Go to SMTP & API → API Keys → Create API Key
# 3. Go to Senders & IPs → verify orders@submitkit.in as a sender
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://submitkit.in

# ── Admin ─────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=change-me-before-production
